#!/bin/bash

# Diligence Agent CLI wrapper
# Flow-based investment analysis tool

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check if virtual environment exists
if [ ! -d ".venv" ]; then
    echo -e "${YELLOW}Virtual environment not found. Setting up...${NC}"
    uv sync
fi

# Function to display help
show_help() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}         DILIGENCE AGENT - Investment Analysis Tool${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Usage:"
    echo "  ./diligence --sources=\"<google_doc_url>\"                    # Start new analysis"
    echo "  ./diligence --flow_id=\"<id>\" --sections=\"<sections>\"       # Resume existing flow"
    echo "  ./diligence --sources=\"<url>\" --sections=\"<sections>\"       # New analysis with specific sections"
    echo ""
    echo "Required for new analysis:"
    echo "  --sources=\"<url>\"          # Google Doc URL containing company data sources"
    echo ""
    echo "Optional parameters:"
    echo "  --flow_id=\"<id>\"           # Resume existing flow with this ID"
    echo "  --sections=\"<sections>\"     # Comma-separated list of sections to run"
    echo "                             # Available: Company Overview,Product,Market,Founders,Final Report"
    echo "  --search_terms=<n>       # Number of search terms to generate for research (default: 5)"
    echo "  --websites=<n>           # Number of websites to scrape per search (default: 10)"
    echo "  --clear_cache            # Clear search/scraping cache before running"
    echo ""
    echo "Examples:"
    echo "  ./diligence --sources=\"https://docs.google.com/document/d/abc123/edit\""
    echo "  ./diligence --flow_id=\"abc-123\" --sections=\"Final Report,Market\""
    echo "  ./diligence --sources=\"https://docs.google.com/.../edit\" --sections=\"Final Report\""
    echo "  ./diligence --sources=\"https://docs.google.com/.../edit\" --clear_cache"
    echo ""
    echo "Options:"
    echo "  -h, --help               # Show this help message"
    echo ""
}

# Parse arguments
SOURCES=""
FLOW_ID=""
SECTIONS=""
SEARCH_TERMS=""
WEBSITES=""
CLEAR_CACHE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        --sources=*)
            SOURCES="${1#*=}"
            shift
            ;;
        --flow_id=*)
            FLOW_ID="${1#*=}"
            shift
            ;;
        --sections=*)
            SECTIONS="${1#*=}"
            shift
            ;;
        --search_terms=*)
            SEARCH_TERMS="${1#*=}"
            shift
            ;;
        --websites=*)
            WEBSITES="${1#*=}"
            shift
            ;;
        --clear_cache)
            CLEAR_CACHE="true"
            shift
            ;;
        *)
            echo -e "${RED}Error: Unknown parameter '$1'${NC}"
            echo ""
            show_help
            exit 1
            ;;
    esac
done

# Validate required parameters
if [[ -z "$SOURCES" && -z "$FLOW_ID" ]]; then
    echo -e "${RED}Error: Either --sources or --flow_id is required${NC}"
    echo ""
    show_help
    exit 1
fi

# Set environment to suppress warnings
export PYTHONWARNINGS="ignore"
export PYTHONDONTWRITEBYTECODE=1

# Build Python command
PYTHON_ARGS=()

if [[ -n "$SOURCES" ]]; then
    PYTHON_ARGS+=("--sources" "$SOURCES")
    echo -e "${GREEN}Starting new analysis with data sources...${NC}"
fi

if [[ -n "$FLOW_ID" ]]; then
    PYTHON_ARGS+=("--flow_id" "$FLOW_ID")
    echo -e "${GREEN}Resuming flow: $FLOW_ID${NC}"
fi

if [[ -n "$SECTIONS" ]]; then
    PYTHON_ARGS+=("--sections" "$SECTIONS")
    echo -e "${BLUE}Running sections: $SECTIONS${NC}"
fi

if [[ -n "$SEARCH_TERMS" ]]; then
    PYTHON_ARGS+=("--search_terms" "$SEARCH_TERMS")
    echo -e "${BLUE}Using $SEARCH_TERMS search terms${NC}"
fi

if [[ -n "$WEBSITES" ]]; then
    PYTHON_ARGS+=("--websites" "$WEBSITES")
    echo -e "${BLUE}Scraping $WEBSITES websites per search${NC}"
fi

if [[ -n "$CLEAR_CACHE" ]]; then
    PYTHON_ARGS+=("--clear_cache")
    echo -e "${YELLOW}Cache will be cleared before running${NC}"
fi

echo ""

# Run the flow
uv run python src/diligence_agent/flow.py "${PYTHON_ARGS[@]}" 2>&1 | grep -v "/site-packages/"